# Copy to server/.env and fill privately. Never commit real credentials.
DATABASE_URL=postgresql://username:password@hostname:5432/database
GMAIL_USER=
GMAIL_APP_PASS=
ADMIN_EMAIL=
APP_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173
PORT=5001
# Set to 1 while testing to prevent outbound email and inbox polling.
DISABLE_EMAIL=0
# For HTTPS production deployments, set NODE_ENV=production in the host environment.
