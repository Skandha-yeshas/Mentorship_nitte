# Copy to server/.env and fill privately. Never commit real credentials.
DATABASE_URL=postgresql://username:password@hostname:5432/database
GMAIL_USER=
GMAIL_APP_PASS=
# Optional institutional SMTP settings; GMAIL_USER/GMAIL_APP_PASS remain supported.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=
APP_URL=http://localhost:5173
APP_ORIGIN=http://localhost:5173
PORT=5001
# Set to 1 while testing to prevent outbound email and inbox polling.
DISABLE_EMAIL=1
# A stable private 32-byte base64 key is mandatory in production. Back it up with recovery secrets.
# Development generates .local/queue-encryption.key; keep that key when restoring its queued data.
QUEUE_ENCRYPTION_KEY=
EMAIL_MAX_PER_MINUTE=10
EMAIL_MAX_PER_24_HOURS=400
# Inbox processing is opt-in and uses the monitored support mailbox.
ENABLE_INBOUND_EMAIL_REPLIES=0
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
# Public call relay. Keep credentials server-side; never use VITE_ variables.
# stun explicitly allows STUN-only calls for now; TURN activation is deferred to handover.
# none is development-only; cloudflare enables the authenticated relay.
TURN_PROVIDER=stun
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
# Diagnostic only: 1 forces calls through TURN to verify actual relay traffic.
TURN_FORCE_RELAY=0
# For HTTPS production deployments, set NODE_ENV=production in the host environment.
